{
  "name": "bilibili-biblioteca",
  "version": "4.1.2",
  "private": true,
  "description": "Aplicativo Windows para organizar, baixar e legendar bibliotecas do Bilibili",
  "scripts": {
    "start": "node server.cjs",
    "setup": "node setup.cjs",
    "test": "node --test test/*.test.cjs",
    "desktop": "electron .",
    "prepare:tools": "node scripts/prepare-tools.cjs",
    "dist": "npm run prepare:tools && electron-builder --win nsis --x64 --publish never",
    "dist:dir": "npm run prepare:tools && electron-builder --win dir --x64 --publish never",
    "test:formats": "node scripts/verify-formats.cjs",
    "test:links:live": "node scripts/verify-links-live.cjs",
    "test:download:live": "node scripts/verify-download-live.cjs",
    "test:desktop": "node scripts/smoke-desktop.cjs",
    "test:release": "node scripts/check-release.cjs",
    "test:layout": "node scripts/verify-layout.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "desktop/main.cjs",
  "author": {
    "name": "Xuim Art",
    "email": "295169208+xuimart@users.noreply.github.com"
  },
  "homepage": "https://github.com/xuimart/bili-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/xuimart/bili-studio.git"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  }
}
